# Arquivo de configuração do Monitor Web
# Copie para .env e preencha os valores reais.
# O .env real é gerado automaticamente pelo setup.sh.

# Chave secreta Flask para assinatura de sessões (32+ bytes hex)
# Gere com: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=substitua_por_chave_gerada_pelo_setup_sh

# Porta TCP em que o servidor irá escutar
MONITOR_PORTA=8180

# HTTPS (opcional): caminhos para certificado e chave privada TLS.
# Se ambos estiverem preenchidos, o servidor sobe em HTTPS e valida o par
# cert/chave na inicialização (encerra o processo se forem inválidos).
# Se ausentes, o servidor sobe em HTTP puro.
# São gerados automaticamente (self-signed) pelo setup.sh caso não existam.
CERT_PATH=
KEY_PATH=
